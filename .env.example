# Environment Configuration for BIS Sahayak (SIH 2026)
PROJECT_NAME="BIS Sahayak"
ENVIRONMENT=production
PORT=8000

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://vamsi2007185.github.io,http://localhost:5173

# Database Configuration (Optional PostgreSQL on Render / Supabase)
DATABASE_URL=postgresql://user:password@hostname:5432/bis_sahayak

# RAG & Embedding Settings
FAISS_INDEX_PATH=data/faiss_index
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Cloud LLM Integration (Recommended: Groq free tier or OpenAI)
GROQ_API_KEY=gsk_your_groq_api_key_here
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Custom OpenAI-compatible LLM endpoint (Optional if using Ollama or vLLM)
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_NAME=llama3

# Digital India Bhashini API (IndicTrans2)
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# WhatsApp Cloud API Configuration
WHATSAPP_VERIFY_TOKEN=bis_sahayak_webhook_token_2026
WHATSAPP_API_TOKEN=your_meta_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
